{
  "name": "@buzzerhood/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts vitest.*.ts --max-warnings=0",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "build": "tsc -p tsconfig.build.json",
    "db:types": "kysely-codegen --dialect postgres --out-file src/common/database/database.generated.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.1",
    "jose": "6.2.10",
    "kysely": "0.29.5",
    "nestjs-pino": "5.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
