NODE_ENV=production
HOST=0.0.0.0
PORT=3100

# Database - connects to buzzerhood-postgres service
DATABASE_URL=postgresql://buzzerhood_app:REPLACE_WITH_APP_PASSWORD@buzzerhood-postgres:5432/buzzerhood
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000

# JWT Configuration
JWT_ISSUER=https://api.dev-buzzerhood.carubra.com
JWT_AUDIENCE=buzzerhood-web
JWT_ACCESS_TTL_SECONDS=600
JWT_PRIVATE_KEY_PATH=/run/secrets/buzzerhood-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/buzzerhood-jwt-public.pem
JWT_KEY_ID=buzzerhood-prod-2026

# Refresh Token Configuration
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=buzzerhood_refresh
CSRF_COOKIE_NAME=buzzerhood_csrf
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# CORS - production origins
CORS_ORIGINS=https://dev-buzzerhood.carubra.com,https://dev-buzzerhood.carubra.com

# Auth Settings
AUTH_REGISTRATION_MODE=closed
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Operational
SWAGGER_ENABLED=false
LOG_LEVEL=info
